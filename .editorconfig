# Code style for the whole repo. EnforceCodeStyleInBuild (Directory.Build.props) makes the
# rules set to warning here fail the build, because warnings are errors.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx,config,webmanifest}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{cs,razor}]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning
csharp_using_directive_placement = outside_namespace
dotnet_diagnostic.IDE0065.severity = warning
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = warning

# Always use braces, even for one-line ifs.
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning

# var where the type is obvious or doesn't matter
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Modern C#: collection expressions, patterns, primary constructors
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
csharp_style_prefer_not_pattern = true
dotnet_diagnostic.IDE0083.severity = warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# C# 15: a labeled break or continue instead of a flag variable or goto
dotnet_diagnostic.IDE0410.severity = warning

[src/MealPlanner.Data/Migrations/**.cs]
# Written by the EF Core tools and kept as generated, so a later migration diffs cleanly.
generated_code = true

[tests/**.cs]
# Test names start with the spec id they prove, for example SEC_02_request_over_64KB_is_refused_with_413.
dotnet_diagnostic.CA1707.severity = none
