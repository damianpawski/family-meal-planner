<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only nuget.org, whatever other sources are configured on the machine. -->
    <clear />
    <!-- minPublishAgeHours: when `dotnet package add` or `dotnet package update` picks a version itself,
         it skips versions published less than 48 hours ago. It doesn't affect restoring pinned versions;
         Dependabot's cooldown covers updates (ADR 12). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" minPublishAgeHours="48" />
  </packageSources>

  <!-- Every package comes from nuget.org, so a package can never be swapped in from another source. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
